# Copy this to .env, fill it in, and keep it out of git (.gitignore already does).
# Wakil Nibs reads these from the environment. It does not load .env by itself,
# so point systemd at it with EnvironmentFile= (see deploy/wakil-nibs.service.example)
# or export the values in your shell.

# The password for adding, editing and deleting. Anyone can view without it.
PENTRACKER_PASSWORD=

# Signs your login cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PENTRACKER_SECRET_KEY=
